{
  "name": "@ybbmm/dsh-session-delete",
  "version": "0.3.0",
  "type": "module",
  "description": "Delete a DeepSeek Harness conversation from the sidebar: a recoverable trash with restore and purge, or permanent removal, with a path-safety guard and an audit trail. | 在 DeepSeek Harness 侧边栏删除对话：可恢复的回收站（支持还原与彻底删除），或永久删除，并带有路径安全校验与审计日志。",
  "license": "MIT",
  "author": "jack-001-a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jack-001-a/deepseek-harness-session-delete.git"
  },
  "homepage": "https://github.com/jack-001-a/deepseek-harness-session-delete#readme",
  "bugs": {
    "url": "https://github.com/jack-001-a/deepseek-harness-session-delete/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "conversation",
    "delete",
    "trash",
    "restore",
    "sidebar",
    "plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
