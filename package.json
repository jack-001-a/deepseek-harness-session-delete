{
  "name": "@ybbmm/dsh-session-delete",
  "version": "0.8.0",
  "type": "module",
  "description": "Safely delete DeepSeek Harness conversations with recoverable Trash, restore, explicit permanent-delete confirmation, guarded session paths, and an audit trail. | 安全删除 DeepSeek Harness 对话：可恢复回收站、恢复功能、明确的永久删除确认、会话路径保护与审计日志。",
  "license": "MIT",
  "author": "jack-001-a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jack-001-a/deepseek-harness-session-delete.git"
  },
  "homepage": "https://github.com/jack-001-a/deepseek-harness-session-delete#readme",
  "bugs": {
    "url": "https://github.com/jack-001-a/deepseek-harness-session-delete/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "conversation",
    "delete",
    "trash",
    "restore",
    "sidebar",
    "plugin",
    "deepseek-harness-plugin",
    "harness-plugin",
    "session-management",
    "conversation-management",
    "session-trash",
    "data-recovery",
    "safe-delete",
    "data-retention",
    "session-restore",
    "trash-manager",
    "conversation-trash",
    "restore-conversations",
    "session-recovery"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "test": "node --test",
    "test:attachment-contract": "node --test test/attachment-reference-contract.test.mjs",
    "test:attachment-filesystem": "node --test test/attachment-hardlink-filesystem.test.mjs",
    "test:browser": "node scripts/verify-delete-dialog-browser.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
